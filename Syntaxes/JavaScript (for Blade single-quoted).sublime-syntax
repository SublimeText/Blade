%YAML 1.2
---
# This hidden syntax is included into quoted strings
# to properly handle {{ echo statements with 'quoted strings' }}.
scope: source.js.blade.embedded.string.quoted.single
version: 2
hidden: true

extends: JavaScript (Blade).sublime-syntax

contexts:
  main:
    - include: expressions

  expressions:
    # required until PR #4003 (ST4177)
    - match: (?=\S)
      push: [ expression-end, expression-begin ]

  expression-begin:
    - meta_prepend: true
    - match: (?=')
      pop: 1

  field-name:
    - meta_prepend: true
    - match: (?=')
      pop: 1

  method-name:
    - meta_prepend: true
    - match: (?=')
      pop: 1

  literal-single-quoted-string:
    - match: (?=')
      pop: 1
